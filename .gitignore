# Local .terraform directory (contains binaries and plugins)
.terraform/

# .tfstate files (contains sensitive data and plain-text secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files by default as they likely contain secrets
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for specific environments if desired (example)
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc